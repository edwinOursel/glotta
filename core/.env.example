# OpenAI API Configuration
# Required for agentic system (intent detection, error correction, validation)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: Customize OpenAI model
# Default: gpt-4o-mini (recommended for cost/performance balance)
# Alternatives: gpt-3.5-turbo (cheaper), gpt-4 (more expensive but better)
OPENAI_MODEL=gpt-4o-mini

# Optional: OpenAI API base URL (for custom endpoints)
# OPENAI_API_BASE=https://api.openai.com/v1

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Model Configuration
# Available: gpt2-small, gpt2-medium, gpt2-large, gpt-neox
JAPANESE_MODEL=gpt2-small

# Default JLPT level for new users
DEFAULT_JLPT_LEVEL=N5

# Default constraint mode
# Options: hard (strict), soft (lenient), adaptive (context-aware)
DEFAULT_CONSTRAINT_MODE=soft

# Agentic System Configuration
MAX_VALIDATION_ITERATIONS=3
VALIDATION_SCORE_THRESHOLD=0.6
